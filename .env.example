# Copy this file to .env and fill in what you use. .env is git-ignored: never commit it -- this
# repository is PUBLIC. Every key is optional: a missing one switches off only what needs it.
# On a new computer, copy the values from the old computer's .env (or the server's ~/quant/.env)
# through a password manager -- never through git, email or chat. See docs/NEW_MACHINE.md.

# ── Market data ───────────────────────────────────────────────────────────────────────────────
# Binance's PUBLIC API needs no key; these are only for authenticated calls.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# ── Email alerts (python -m quant.alerts; docs/ALERTS.md) ────────────────────────────────────
# The password is a Gmail APP PASSWORD (Google Account > Security > App passwords), never the
# account's own password. ALERT_EMAIL_TO empty = send to ALERT_SMTP_USER.
ALERT_SMTP_USER=
ALERT_SMTP_PASSWORD=
ALERT_EMAIL_TO=
# Only if not Gmail (the defaults are smtp.gmail.com and 587):
# ALERT_SMTP_HOST=
# ALERT_SMTP_PORT=

# ── Push notifications, a copy of every alert email (DELIVERY push="ntfy"; docs/ALERTS.md) ───
# The topic works like a PASSWORD: anyone who knows it reads your alerts. Use the same topic as
# the alerts server, so your phone keeps getting them.
NTFY_TOPIC=
# Only for your own ntfy server (the default is https://ntfy.sh) or one that needs a login:
# NTFY_SERVER=
# NTFY_TOKEN=

# ── The economic calendar (python -m quant.news; docs/NEWS.md) ───────────────────────────────
# FRED, free (https://fredaccount.stlouisfed.org/apikeys): US release dates and the US actuals.
FRED_API_KEY=
# JBlanked, optional: actuals outside the US, and only with paid credits.
JBLANKED_API_KEY=
# BLS, optional: a higher daily limit for the live US numbers.
BLS_API_KEY=
