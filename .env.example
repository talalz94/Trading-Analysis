# Copy to .env and fill in. .env is gitignored.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Email alerts (python -m quant.alerts; docs/ALERTS.md). The password is a Gmail APP PASSWORD,
# created under Google Account > Security > App passwords -- never your account password.
ALERT_SMTP_USER=
ALERT_SMTP_PASSWORD=
ALERT_EMAIL_TO=
